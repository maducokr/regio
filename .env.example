# PostgreSQL
# 앱은 regio_app(일반 사용자) 권장 — node setup-db-app-role.js 로 생성
DB_USER=regio_app
DB_HOST=localhost
DB_NAME=regio
DB_PASSWORD=your_password
DB_PORT=5432
DB_POOL_MAX=5

# --- 모의(테스트) vs Deploy 구분 ---
# 로컬: localhost + DB_HOST=localhost → 샘플/TEST 메뉴·시드 허용
# Deploy: NODE_ENV=production, piregio/deploy-mode.js → 실회원 DB만
# GET /api/runtime-mode 로 서버 모드 확인 가능
# NODE_ENV=production 이면 샘플·TEST API 차단 (실서비스 DB만 사용)
# NODE_ENV=production
# 로컬이 아닌 DB에 assign-*.js / generate-*.js 시드를 쓸 때만 (기본 금지)
# ALLOW_SAMPLE_SEED=1
# 프로덕션에서도 샘플 API를 임시 허용할 때만
# ALLOW_SAMPLE_TOOLS=1
# 고아 연결 정리용 슈퍼유저 (선택, 기본 postgres)
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=your_admin_password

# 백업(pg_dump) — 선택
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# DB_BACKUP_KEEP=15
# 추가 미러(기본 E:\regioback). 끄려면 off
# REGIOBACK_EXTRA=E:\regioback
# REGIOBACK_EXTRA=E:\regioback,D:\backup\regio

# Gmail 인증 메일 발송 (Google 계정 → 앱 비밀번호)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Google 로그인 (Google Cloud Console → OAuth 2.0 클라이언트 ID)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Google Play 인앱결제 (Play Console → API 액세스 → 서비스 계정)
# GOOGLE_PLAY_PACKAGE_NAME=com.regio.note
# GOOGLE_PLAY_PRODUCT_IDS=regio_premium_monthly,regio_premium_yearly
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 또는 GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
