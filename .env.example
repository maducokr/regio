# PostgreSQL
# 로컬: DB_* 사용 / Render: DATABASE_URL(Internal Database URL) 필수
# DB_USER=regio_app
# DB_HOST=localhost
# DB_NAME=regio
# DB_PASSWORD=your_password
# DB_PORT=5432
# DB_POOL_MAX=5

# Render Web Service Environment (필수)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# ※ DB_HOST=localhost 는 Render에서 절대 두지 마세요 (ECONNREFUSED 원인)

# --- 모의(테스트) vs Deploy 구분 ---
# 로컬: localhost + DB_HOST=localhost → 샘플/TEST 메뉴·시드 허용
# Deploy: NODE_ENV=production → 샘플·TEST API 차단
# ALLOW_SAMPLE_SEED=1
# ALLOW_SAMPLE_TOOLS=1
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=your_admin_password

# Gmail 인증 메일 발송 (Google 계정 → 앱 비밀번호)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Google 로그인 (Google Cloud Console → OAuth 2.0 클라이언트 ID)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Google Play 인앱결제
# GOOGLE_PLAY_PACKAGE_NAME=com.regio.note
# GOOGLE_PLAY_PRODUCT_IDS=regio_premium_monthly,regio_premium_yearly
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# 개인활동 입력 자료 자동삭제 (기록일 activity_date 기준, 기본 30개월)
# ACTIVITY_RETENTION_MONTHS=30
# ACTIVITY_AUTO_PURGE=1
